# Discord ---------------------------------------------------------------
# USER token, not a bot token. This bot signs in as a normal Discord account
# so it appears as a person rather than an app.
#
# Automating a user account breaks Discord's Terms of Service, and the usual
# penalty is losing that account. Use a dedicated account you can afford to
# lose, never your own.
#
# To get it: log into that account in a browser, open DevTools (F12) ->
# Application -> Local Storage -> discord.com -> the "token" value.
# The token changes whenever that account changes its password.
DISCORD_USER_TOKEN=

# Comma-separated channel IDs the bot is allowed to answer in.
# Right-click a channel in Discord (with Developer Mode on) -> Copy Channel ID.
# Leave empty and the bot answers nowhere - this is a deliberate safety default.
ALLOWED_CHANNEL_IDS=

# Source channels to read. The bot always writes proposals only to #bot-test.
WATCH_CHANNEL_IDS=925207817923743797,927612226439880834
WATCH_CATEGORY_IDS=1466703931194212445

# Optional local Discord-history retrieval. The index command reads only the
# configured channels/categories and writes a scrubbed file under .runtime/.
HISTORY_STAFF_IDS=1161631744768884746,1477996916435320833,922701376759410758
HISTORY_MESSAGES_PER_CHANNEL=1000

# Optional read-only implementation search. These roots are fixed before the
# bot starts; the model cannot choose paths or execute shell commands.
# Live support is Olympus-only. Keep this as `olympus`; Valhalla files and
# paths remain dormant for a future deliberate re-enable.
SUPPORTED_PRODUCTS=olympus
CODEBASE_VALHALLA_PATH=
CODEBASE_OLYMPUS_PATH=
CODEBASE_SEARCH_ENABLED=false
# Legacy setting retained for dormant Valhalla code. It has no effect while
# SUPPORTED_PRODUCTS=olympus.
REPOSITORY_SEARCH_BOTH=true
# Keep verified FAQ facts enabled for fees, product promises, security, and
# onboarding. Set false only for a repository-only shadow evaluation; account,
# secret, and security safeguards remain on either way.
APPROVED_FACTS_ENABLED=true

# Role to ping when the bot doesn't know the answer. Optional.
STAFF_ROLE_ID=

# How many recent messages to feed the model as conversation context.
CONTEXT_MESSAGES=8

# Discord transport -----------------------------------------------------
# REST avoids discum's unsupported user-account WebSocket. New tagged
# messages are detected within this poll interval; keep it at 10+ seconds to
# stay comfortably within Discord REST rate limits.
DISCORD_TRANSPORT=rest
REST_POLL_SECONDS=15

# Optional four-hour conversation memory. This supplements, but does not
# replace, the recent Discord window. It is scoped by guild/channel/thread/user
# and is ignored if Redis is unavailable. Keep the URL local or use a private
# Redis service; do not put credentials in the repository.
CONVERSATION_MEMORY_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=salena:conversation
CONVERSATION_TTL_SECONDS=14400
CONVERSATION_MAX_TURNS=32
CONVERSATION_MAX_CHARS=18000
CONVERSATION_CONTEXT_MAX_CHARS=12000
CONVERSATION_SUMMARY_MAX_CHARS=3000

# Reply pacing. How long she waits before answering, picked at random in this
# range. 30-120 is the human-looking setting for a live channel. While the team
# is testing in #bot-test nobody is being fooled and the wait is just friction,
# so keep it low there and raise it before she answers real users.
REPLY_DELAY_MIN_SECONDS=30
REPLY_DELAY_MAX_SECONDS=120

# The bot never sends a Discord typing indicator.

# Answers produced at once. Keep it low: a user account replying in several
# channels simultaneously is exactly what automation detection looks for.
WORKER_THREADS=2

# Safe default: draft every answer into #bot-test for staff review. Set this
# to false only after the official Discord bot account and evaluation gate are
# ready for live replies.
SHADOW_MODE=true

# LLM -------------------------------------------------------------------
OPENAI_API_KEY=
# GPT-6 Luna is the cost-efficient reasoning model used by the support pipeline.
# It uses the Responses API, enabling deliberate repository research.
OPENAI_MODEL=gpt-6-luna
# Supported: none, low, medium, high, xhigh, max. Medium is a balanced default.
OPENAI_REASONING_EFFORT=medium

# Seconds one model call may take before it is treated as failed. The SDK
# default is ten minutes, which just leaves the user watching a typing dot.
LLM_TIMEOUT_SECONDS=30

# Wording variance. Low values make her repeat herself verbatim, which is the
# most obvious tell there is. 0.9 keeps the facts steady and the phrasing fresh.
LLM_TEMPERATURE=0.9

# Attempts per question, including the first. Only transient failures
# (timeout, rate limit, 5xx) are retried; a bad key fails immediately.
LLM_MAX_ATTEMPTS=3

# Strict JSON is used for routing, research, and drafted answers. Allow enough
# room for citations and validation fields; malformed or empty JSON is retried
# within the bounded attempt limit.
LLM_JSON_MAX_OUTPUT_TOKENS=1200

# On startup, recover recently tagged messages that a stalled poller could not
# process. This does not widen the channel allowlist or answer ordinary chat.
REST_BACKFILL_GRACE_SECONDS=300

# Gateway compatibility -------------------------------------------------
# Used only if DISCORD_TRANSPORT=gateway. REST mode polls at
# REST_POLL_SECONDS instead.
SWEEP_MINUTES=5
SWEEP_LOOKBACK_MINUTES=30
SWEEP_MAX_REPLIES=5

# Replace a silent or closed gateway with a brand-new process/WebSocket. This
# is needed because discum cannot reliably reopen a socket after it closes.
GATEWAY_STALE_SECONDS=180
# Allow bounded fresh-socket retries to finish before launchd restarts the
# whole process. Backoff avoids exhausting local ephemeral network ports.
GATEWAY_RECOVERY_GRACE_SECONDS=120
GATEWAY_RECONNECT_MAX_SECONDS=60
GATEWAY_RESTART_GRACE_SECONDS=20

# Times the bot will try to answer one message before writing it off. A
# question that failed on a blip gets picked up again by the next sweep.
ANSWER_ATTEMPTS=3

# Alerts ----------------------------------------------------------------
# Optional. A Discord webhook the bot posts to when it is in trouble:
# the model is unreachable, it can't reply in a channel, the sweep crashed.
# Leave empty to disable alerting entirely.
# Create one: channel settings -> Integrations -> Webhooks -> New Webhook.
# Treat the URL as a secret. Anyone who has it can post as that webhook.
ALERT_WEBHOOK_URL=

# Optional, prepended to every alert so it actually pings someone.
# Format: <@USER_ID> for a person, <@&ROLE_ID> for a role.
ALERT_MENTION=

# Daily OpenAI usage report ------------------------------------------------
# Optional. A separate Discord webhook that receives one read-only report per
# 24 hours: estimated cost, API calls, and input/output/reasoning token totals.
# The ledger stores counts only, never Discord text or model output.
# Treat this URL as a secret. Anyone holding it can post through the webhook.
DAILY_USAGE_WEBHOOK_URL=
# Keep the active daily report message up to date after each completed support
# response. It edits the same webhook message instead of creating message spam.
USAGE_REPORT_LIVE_UPDATES=true
