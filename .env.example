# Discord ---------------------------------------------------------------
# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_BOT_TOKEN=

# Comma-separated channel IDs the bot is allowed to answer in.
# Right-click a channel in Discord (with Developer Mode on) -> Copy Channel ID.
# Leave empty and the bot answers nowhere - this is a deliberate safety default.
ALLOWED_CHANNEL_IDS=

# Role to ping when the bot doesn't know the answer. Optional.
STAFF_ROLE_ID=

# How many recent messages to feed the model as conversation context.
CONTEXT_MESSAGES=8

# Seconds a single user must wait between questions.
USER_COOLDOWN_SECONDS=10

# LLM -------------------------------------------------------------------
OPENAI_API_KEY=
# Ask Professor which model his credits cover. gpt-4o-mini is a good default.
OPENAI_MODEL=gpt-4o-mini

# Catch-up sweep --------------------------------------------------------
# Safety net for messages missed while the bot was offline. The gateway is
# the primary path; on a healthy bot this finds nothing.
SWEEP_MINUTES=5
SWEEP_LOOKBACK_MINUTES=30
SWEEP_MAX_REPLIES=5
