# Discord ---------------------------------------------------------------
# USER token, not a bot token. This bot signs in as a normal Discord account
# so it appears as a person rather than an app.
#
# Automating a user account breaks Discord's Terms of Service, and the usual
# penalty is losing that account. Use a dedicated account you can afford to
# lose, never your own.
#
# To get it: log into that account in a browser, open DevTools (F12) ->
# Application -> Local Storage -> discord.com -> the "token" value.
# The token changes whenever that account changes its password.
DISCORD_USER_TOKEN=

# Comma-separated channel IDs the bot is allowed to answer in.
# Right-click a channel in Discord (with Developer Mode on) -> Copy Channel ID.
# Leave empty and the bot answers nowhere - this is a deliberate safety default.
ALLOWED_CHANNEL_IDS=

# Role to ping when the bot doesn't know the answer. Optional.
STAFF_ROLE_ID=

# How many recent messages to feed the model as conversation context.
CONTEXT_MESSAGES=8

# Reply pacing, so answers don't land instantly. The reply is held for about
# as long as typing it would take: length / chars-per-second, clamped, jittered.
TYPING_CHARS_PER_SECOND=18
TYPING_MIN_SECONDS=2
TYPING_MAX_SECONDS=9

# Answers produced at once. Keep it low: a user account replying in several
# channels simultaneously is exactly what automation detection looks for.
WORKER_THREADS=2

# LLM -------------------------------------------------------------------
OPENAI_API_KEY=
# Ask Professor which model his credits cover. gpt-4o-mini is a good default.
OPENAI_MODEL=gpt-4o-mini

# Seconds one model call may take before it is treated as failed. The SDK
# default is ten minutes, which just leaves the user watching a typing dot.
LLM_TIMEOUT_SECONDS=30

# Wording variance. Low values make her repeat herself verbatim, which is the
# most obvious tell there is. 0.9 keeps the facts steady and the phrasing fresh.
LLM_TEMPERATURE=0.9

# Attempts per question, including the first. Only transient failures
# (timeout, rate limit, 5xx) are retried; a bad key fails immediately.
LLM_MAX_ATTEMPTS=3

# Catch-up sweep --------------------------------------------------------
# Safety net for messages missed while the bot was offline. The gateway is
# the primary path; on a healthy bot this finds nothing.
SWEEP_MINUTES=5
SWEEP_LOOKBACK_MINUTES=30
SWEEP_MAX_REPLIES=5

# Times the bot will try to answer one message before writing it off. A
# question that failed on a blip gets picked up again by the next sweep.
ANSWER_ATTEMPTS=3

# Alerts ----------------------------------------------------------------
# Optional. A Discord webhook the bot posts to when it is in trouble:
# the model is unreachable, it can't reply in a channel, the sweep crashed.
# Leave empty to disable alerting entirely.
# Create one: channel settings -> Integrations -> Webhooks -> New Webhook.
# Treat the URL as a secret. Anyone who has it can post as that webhook.
ALERT_WEBHOOK_URL=

# Optional, prepended to every alert so it actually pings someone.
# Format: <@USER_ID> for a person, <@&ROLE_ID> for a role.
ALERT_MENTION=
